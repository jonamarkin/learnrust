# Generated by Cargo (matches target/ in root or any subfolder)
target/
**/target/

# Direct rustc compiler outputs (standalone binaries & build artifacts)
hello_world/main
*.exe
*.o
*.a
*.so
*.dylib
*.dll
*.rlib
*.pdb

# Rustfmt & backup files
**/*.rs.bk
*.bk

# Coverage & profiling data
default.profraw
cobertura.xml
tarpaulin-report.html

# IDE / Editor folders and files
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# Operating system files
.DS_Store
Thumbs.db

# Note on Cargo.lock:
# In Rust, Cargo.lock is kept in Git for applications/binary executables
# to ensure reproducible builds. If you wish to ignore it instead, uncomment:
# Cargo.lock
